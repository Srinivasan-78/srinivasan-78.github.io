{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  /* Only src — the shared lib modules the worker actually imports are pulled
     in transitively and still checked. Globbing all of ../lib dragged in
     seo.ts, which imports "next", a dep the worker build never installs. */
  "include": ["src/**/*.ts"]
}
